#!/usr/bin/env bats
# tests/bats/generate-inventory.bats — scripts/generate-inventory.sh against a
# fake `terraform` that prints canned `output -json`.
#
# What is pinned down: the Terraform output contract documented in the script
# header, that files land in the operating repository (the current directory)
# and not under TF_DIR, and that the user's own group_vars/all.yml survives.

REPO_ROOT="$(cd "$(dirname "$BATS_TEST_FILENAME")/../.." && pwd)"
SCRIPT="${REPO_ROOT}/scripts/generate-inventory.sh"

setup() {
  PROJECT="${BATS_TEST_TMPDIR}/config-repo"
  mkdir -p "${PROJECT}/terraform" "${BATS_TEST_TMPDIR}/bin"
  OUTPUTS="${BATS_TEST_TMPDIR}/outputs.json"
  # The fake asserts it was called as `-chdir=<dir> output -json`.
  {
    echo '#!/usr/bin/env bash'
    echo '[[ "$1" == -chdir=* && "$2" == output && "$3" == -json ]] || { echo "unexpected: $*" >&2; exit 9; }'
    echo "cat '${OUTPUTS}'"
  } > "${BATS_TEST_TMPDIR}/bin/terraform"
  chmod +x "${BATS_TEST_TMPDIR}/bin/terraform"
  export PATH="${BATS_TEST_TMPDIR}/bin:${PATH}"
  export K3S_VERSION="v1.32.13+k3s1" CLUSTER_DOMAIN="example.test"
  # Relative, as the provision taskfile passes them.
  export TF_DIR=terraform ANSIBLE_DIR=ansible
  unset CLUSTER_ENV K3S_LAB_ENV_FILE K3S_LAB_PROJECT_DIR K3S_UFW_ALLOW_FROM
  cd "$PROJECT"
}

full_outputs() {
  cat > "$OUTPUTS" <<'JSON'
{
  "server_name": {"value": "srv"},
  "server_ip": {"value": "203.0.113.10"},
  "server_private_ip": {"value": "10.0.0.2"},
  "agent_names": {"value": ["ag1", "ag2"]},
  "agent_ips": {"value": ["203.0.113.11", "203.0.113.12"]},
  "agent_private_ips": {"value": ["10.0.0.3"]}
}
JSON
}

inv() { yq -o=json '.' "${PROJECT}/ansible/inventory/hosts.yml"; }

@test "writes hosts.yml in the operating repo, not under TF_DIR" {
  full_outputs
  run "$SCRIPT"
  [ "$status" -eq 0 ]
  [ -f "${PROJECT}/ansible/inventory/hosts.yml" ]
  [ ! -e "${PROJECT}/terraform/ansible" ]
}

@test "the inventory carries the server, the agents and their cluster addresses" {
  full_outputs
  run "$SCRIPT"
  [ "$status" -eq 0 ]
  [ "$(inv | jq -r '.all.children.k3s_servers.hosts.srv.ansible_host')" = "203.0.113.10" ]
  [ "$(inv | jq -r '.all.children.k3s_servers.hosts.srv.k3s_node_ip')" = "10.0.0.2" ]
  [ "$(inv | jq -r '.all.children.k3s_agents.hosts.ag1.k3s_node_ip')" = "10.0.0.3" ]
  [ "$(inv | jq -r '.all.children.k3s_agents.hosts.ag2.ansible_host')" = "203.0.113.12" ]
  # ag2 has no private IP: no k3s_node_ip key rather than an empty one
  [ "$(inv | jq -r '.all.children.k3s_agents.hosts.ag2 | has("k3s_node_ip")')" = "false" ]
}

@test "server-only outputs give a single-node inventory" {
  echo '{"server_name":{"value":"srv"},"server_ip":{"value":"192.0.2.1"}}' > "$OUTPUTS"
  run "$SCRIPT"
  [ "$status" -eq 0 ]
  [ "$(inv | jq -r '.all.children.k3s_agents.hosts | length')" = "0" ]
  [ "$(inv | jq -r '.all.children.k3s_servers.hosts.srv | has("k3s_node_ip")')" = "false" ]
}

@test "a missing required output is named" {
  echo '{"server_name":{"value":"srv"}}' > "$OUTPUTS"
  run "$SCRIPT"
  [ "$status" -eq 1 ]
  [[ "$output" == *"missing"*"server_ip"* ]]
}

@test "agent lists of different lengths are refused" {
  echo '{"server_name":{"value":"s"},"server_ip":{"value":"1.1.1.1"},"agent_names":{"value":["a","b"]},"agent_ips":{"value":["2.2.2.2"]}}' > "$OUTPUTS"
  run "$SCRIPT"
  [ "$status" -eq 1 ]
  [[ "$output" == *"different lengths"* ]]
}

@test "generated vars go to group_vars/all/generated.yml with the pin" {
  full_outputs
  K3S_UFW_ALLOW_FROM=192.168.0.0/24 run "$SCRIPT"
  [ "$status" -eq 0 ]
  gen="${PROJECT}/ansible/inventory/group_vars/all/generated.yml"
  [ "$(yq -r '.k3s_version' "$gen")" = "v1.32.13+k3s1" ]
  [ "$(yq -r '.k3s_ufw_allow_from' "$gen")" = "192.168.0.0/24" ]
  [ "$(yq -r '.cluster_domain' "$gen")" = "example.test" ]
}

@test "the user's own group_vars/all.yml is left untouched" {
  full_outputs
  mkdir -p "${PROJECT}/ansible/inventory/group_vars"
  printf -- '---\nwireguard_enabled: true\n' > "${PROJECT}/ansible/inventory/group_vars/all.yml"
  run "$SCRIPT"
  [ "$status" -eq 0 ]
  [ "$(yq -r '.wireguard_enabled' "${PROJECT}/ansible/inventory/group_vars/all.yml")" = "true" ]
}

@test "a group_vars/all.yml generated by an older version is removed" {
  full_outputs
  mkdir -p "${PROJECT}/ansible/inventory/group_vars"
  printf -- '---\n# Auto-generated from cluster.env — do not edit manually\nk3s_version: "v1.30.0+k3s1"\n' \
    > "${PROJECT}/ansible/inventory/group_vars/all.yml"
  run "$SCRIPT"
  [ "$status" -eq 0 ]
  [ ! -e "${PROJECT}/ansible/inventory/group_vars/all.yml" ]
}

@test "K3S_VERSION is required" {
  full_outputs
  unset K3S_VERSION
  run "$SCRIPT"
  [ "$status" -ne 0 ]
  [[ "$output" == *"K3S_VERSION"* ]]
}

@test "CLUSTER_ENV, when given, is loaded" {
  full_outputs
  unset K3S_VERSION CLUSTER_DOMAIN
  printf 'K3S_VERSION=v1.33.1+k3s1\nCLUSTER_DOMAIN=from.env\n' > "${BATS_TEST_TMPDIR}/cluster.env"
  CLUSTER_ENV="${BATS_TEST_TMPDIR}/cluster.env" run "$SCRIPT"
  [ "$status" -eq 0 ]
  [ "$(yq -r '.k3s_version' "${PROJECT}/ansible/inventory/group_vars/all/generated.yml")" = "v1.33.1+k3s1" ]
}
